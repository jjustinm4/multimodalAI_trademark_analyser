# Backend settings. docker-compose.yml sets these for the container;
# this file is read when running the backend directly on the host.
DATABASE_URL=postgresql+asyncpg://trademark:trademark_dev@localhost:5432/trademark
LLM_BASE_URL=http://localhost:8080/v1
LLM_MODEL=gpt-oss-20b
FUSION_W_PHONETIC=0.30
FUSION_W_SEMANTIC=0.30
FUSION_W_VISUAL=0.20
FUSION_W_GOODS=0.20
EMBEDDING_DEVICE=cuda
